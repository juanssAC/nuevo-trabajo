      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\nbody{margin:0;background:#f4f6f5;color:#202b34;font-family:'DM Sans',sans-serif;font-synthesis:none}\n.pichangas-page{min-height:100vh;background:#f4f6f5}\n.pichangas-title{font-family:'Manrope',sans-serif;letter-spacing:-.045em}\n.pichangas-label{font-size:10px;line-height:1.2;font-weight:700;letter-spacing:.14em;text-transform:uppercase}\n.primary-surface{box-shadow:0 18px 44px rgba(17,24,32,.14)}\n.mobile-bottom-nav{padding-bottom:max(10px,env(safe-area-inset-bottom))}\n@media(max-width:719px){\n  .mobile-bottom-nav{display:grid}\n  .mobile-page-main{padding-bottom:104px}\n  .mobile-surface{border-radius:12px}\n}\n@media(min-width:720px){.mobile-bottom-nav{display:none}}\n</style>\n<div class=\"pichangas-page min-h-screen lg:grid lg:grid-cols-[236px_minmax(0,1fr)]\" data-kid=\"1\">\n    <aside class=\"hidden min-h-screen flex-col bg-[#111820] px-5 py-7 text-white lg:flex\" data-kid=\"1-1\">\n        <div class=\"mb-16 flex items-center gap-3 px-2\" data-kid=\"1-1-1\">\n            <span class=\"grid size-9 place-items-center rounded-[9px] bg-[#8bdee0] text-[19px] font-bold text-[#111820]\" data-kid=\"1-1-1-1\">\n                P\n            </span>\n            <div data-kid=\"1-1-1-2\">\n                <p class=\"m-0 font-['Manrope'] text-[17px] font-extrabold leading-none tracking-[-.04em]\" data-kid=\"1-1-1-2-1\">\n                    PICHANGAS\n                </p>\n                <p class=\"m-0 mt-1 text-[8px] font-bold uppercase tracking-[.17em] text-[#91a0ad]\" data-kid=\"1-1-1-2-2\">\n                    Control de ventas\n                </p>\n            </div>\n        </div>\n        <nav aria-label=\"Navegación principal\" class=\"grid gap-2\" data-kid=\"1-1-2\">\n            <a class=\"flex h-11 items-center gap-3 rounded-[7px] bg-[#23313d] px-3 text-[12px] font-bold text-white\" data-kid=\"1-1-2-1\" href=\"#resumen\">\n                <i class=\"size-[17px] text-[#8bdee0]\" data-kid=\"1-1-2-1-1\" data-lucide=\"layout-dashboard\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\">\n                    Resumen\n                </span>\n            </a>\n            <a class=\"flex h-11 items-center gap-3 rounded-[7px] px-3 text-[12px] font-bold text-[#91a0ad]\" data-kid=\"1-1-2-2\" href=\"#cierre\">\n                <i class=\"size-[17px] text-[#7a8a98]\" data-kid=\"1-1-2-2-1\" data-lucide=\"plus\" data-name=\"plus sign icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\">\n                    Cierre diario\n                </span>\n            </a>\n            <a class=\"flex h-11 items-center gap-3 rounded-[7px] px-3 text-[12px] font-bold text-[#91a0ad]\" data-kid=\"1-1-2-3\" href=\"#repartos\">\n                <i class=\"size-[17px] text-[#7a8a98]\" data-kid=\"1-1-2-3-1\" data-lucide=\"truck\" data-name=\"delivery truck icon\">\n                </i>\n                <span class=\"flex-1\" data-kid=\"1-1-2-3-2\">\n                    Repartos\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#ec9c6a]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3\" data-name=\"pending deliveries count\" data-reason=\"count updated dynamically by script\">\n                    0\n                </span>\n            </a>\n            <a class=\"flex h-11 items-center gap-3 rounded-[7px] px-3 text-[12px] font-bold text-[#91a0ad]\" data-kid=\"1-1-2-4\" href=\"#reportes\">\n                <i class=\"size-[17px] text-[#7a8a98]\" data-kid=\"1-1-2-4-1\" data-lucide=\"bar-chart-3\" data-name=\"bar chart icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\">\n                    Reportes\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto border-t border-[#2b3944] px-2 pt-4 text-[10px] leading-5 text-[#84939f]\" data-kid=\"1-1-3\">\n            <span class=\"mr-2 inline-block size-2 rounded-full bg-[#57b980] align-middle\" data-kid=\"1-1-3-1\">\n            </span>\n            Datos guardados en este dispositivo\n        </div>\n    </aside>\n    <div class=\"min-w-0\" data-kid=\"1-2\">\n        <header class=\"flex min-h-[78px] items-center justify-between border-b border-[#e3e8e8] bg-white px-5 sm:px-8 lg:px-12\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <p class=\"pichangas-label m-0 text-[#93a0a9]\" data-kid=\"1-2-1-1-1\">\n                    PICHANGAS / CONTROL\n                </p>\n                <h1 class=\"pichangas-title m-0 mt-2 text-[21px] font-bold text-[#202b34] sm:text-[23px]\" data-kid=\"1-2-1-1-2\">\n                    Resumen del negocio\n                </h1>\n            </div>\n            <div class=\"flex items-center gap-3 text-[11px] font-semibold text-[#7f8c96]\" data-kid=\"1-2-1-2\">\n                <i class=\"size-[17px] text-[#202b34]\" data-kid=\"1-2-1-2-1\" data-lucide=\"calendar-days\" data-name=\"calendar icon\">\n                </i>\n                <span class=\"hidden sm:inline\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2\" data-name=\"current date text\" data-reason=\"date updated by script\">\n                    Hoy · 07 sep 2026\n                </span>\n            </div>\n        </header>\n        <main class=\"mobile-page-main mx-auto max-w-[1120px] px-5 py-7 sm:px-8 lg:px-12 lg:py-10\" data-kid=\"1-2-2\" id=\"resumen\">\n            <div class=\"mb-6 flex flex-col gap-2 sm:mb-7\" data-kid=\"1-2-2-1\">\n                <p class=\"pichangas-label m-0 text-[#7f8c96]\" data-kid=\"1-2-2-1-1\">\n                    Panel del dueño\n                </p>\n                <h2 class=\"pichangas-title m-0 text-[28px] font-bold leading-[1.06] text-[#202b34] sm:text-[34px]\" data-kid=\"1-2-2-1-2\">\n                    Tu turno empieza aquí.\n                </h2>\n                <p class=\"m-0 max-w-[560px] text-[13px] leading-6 text-[#687984]\" data-kid=\"1-2-2-1-3\">\n                    Registra lo vendido, confirma tus repartos y termina el día con un total claro.\n                </p>\n            </div>\n            <section aria-label=\"Estado de hoy\" class=\"primary-surface mobile-surface overflow-hidden rounded-[12px] bg-[#111820] p-5 text-white sm:p-7 lg:p-8\" data-kid=\"1-2-2-2\">\n                <div class=\"flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between lg:gap-10\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-2-1-1\">\n                        <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-2-2-1-1-1\">\n                            <span class=\"pichangas-label text-[#ec9c6a]\" data-kid=\"1-2-2-2-1-1-1-1\">\n                                Pendiente\n                            </span>\n                            <span class=\"h-1 w-1 rounded-full bg-[#52616d]\" data-kid=\"1-2-2-2-1-1-1-2\">\n                            </span>\n                            <span class=\"pichangas-label text-[#9aaab6]\" data-kid=\"1-2-2-2-1-1-1-3\">\n                                Hoy · lunes 7 de septiembre\n                            </span>\n                        </div>\n                        <div class=\"mt-5 flex flex-wrap items-end gap-x-3 gap-y-1\" data-kid=\"1-2-2-2-1-1-2\">\n                            <strong class=\"pichangas-title text-[48px] font-extrabold leading-none tracking-[-.07em] sm:text-[56px]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"today total sales amount\" data-reason=\"amount updated by script\">\n                                $0\n                            </strong>\n                            <span class=\"mb-1 text-[12px] font-semibold text-[#9aaab6]\" data-kid=\"1-2-2-2-1-1-2-2\">\n                                CLP registrados\n                            </span>\n                        </div>\n                        <p class=\"m-0 mt-3 max-w-[490px] text-[13px] leading-6 text-[#b6c0c7]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"day summary description text\" data-reason=\"text updated based on state by script\">\n                            Todavía no hay un cierre para hoy. Cuando termines la jornada, este será el total que debes revisar.\n                        </p>\n                    </div>\n                    <div class=\"shrink-0 lg:w-[270px]\" data-kid=\"1-2-2-2-1-2\">\n                        <p class=\"pichangas-label m-0 text-[#8bdee0]\" data-kid=\"1-2-2-2-1-2-1\">\n                            Siguiente acción\n                        </p>\n                        <h3 class=\"pichangas-title m-0 mt-2 text-[18px] font-bold leading-tight\" data-kid=\"1-2-2-2-1-2-2\">\n                            Registra lo vendido hoy\n                        </h3>\n                        <button class=\"mt-5 flex min-h-[46px] w-full items-center justify-between gap-3 rounded-[6px] bg-[#8bdee0] px-4 text-left text-[12px] font-bold text-[#111820]\" data-kid=\"1-2-2-2-1-2-3\">\n                            <span data-kid=\"1-2-2-2-1-2-3-1\">\n                                Registrar cierre\n                            </span>\n                            <i class=\"size-[17px]\" data-kid=\"1-2-2-2-1-2-3-2\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <div class=\"mt-6 grid gap-6 lg:grid-cols-[1.35fr_.85fr]\" data-kid=\"1-2-2-3\">\n                <section aria-labelledby=\"activity-title\" class=\"rounded-[10px] border border-[#dfe6e6] bg-white p-5 sm:p-6\" data-kid=\"1-2-2-3-1\">\n                    <div class=\"flex items-start justify-between gap-4 border-b border-[#e3e8e8] pb-4\" data-kid=\"1-2-2-3-1-1\">\n                        <div data-kid=\"1-2-2-3-1-1-1\">\n                            <p class=\"pichangas-label m-