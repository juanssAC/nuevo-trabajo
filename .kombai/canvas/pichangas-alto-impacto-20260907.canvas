    "var_6b0e8a898c1d": {
      "type": "variant",
      "label": "Pichangas — Operación Directa",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n  :root {\n    --navy: #111820;\n    --navy-soft: #1d2a34;\n    --paper: #f4f6f5;\n    --surface: #ffffff;\n    --ink: #202b34;\n    --muted: #6d7b84;\n    --muted-soft: #93a0a9;\n    --line: #dde5e4;\n    --cyan: #8bdee0;\n    --cyan-ink: #287e82;\n    --green: #57b980;\n    --green-soft: #e5f5ec;\n    --shadow: 0 6px 20px rgba(29,48,61,.045);\n  }\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: 'DM Sans', sans-serif;\n    font-synthesis: none;\n  }\n  button { font: inherit; cursor: pointer; }\n  .app-shell { min-height: 100vh; background: var(--paper); }\n  .sidebar {\n    position: fixed;\n    inset: 0 auto 0 0;\n    z-index: 10;\n    width: 232px;\n    padding: 30px 18px 22px;\n    display: flex;\n    flex-direction: column;\n    background: var(--navy);\n    color: #fff;\n  }\n  .brand { display: flex; align-items: center; gap: 10px; margin: 0 10px 58px; color: #fff; text-decoration: none; }\n  .brand-mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; background: var(--cyan); color: var(--navy); font: 800 17px/1 'Manrope'; }\n  .brand-name { font: 800 17px/1 'Manrope'; letter-spacing: -.65px; }\n  .brand-subtitle { display: block; margin-top: 5px; color: #91a1ad; font: 700 7px/1 'DM Sans'; letter-spacing: 1.25px; }\n  .sidebar nav { display: grid; gap: 6px; }\n  .nav-link {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    width: 100%;\n    min-height: 44px;\n    padding: 0 13px;\n    border: 0;\n    border-radius: 7px;\n    background: transparent;\n    color: #91a0ad;\n    text-align: left;\n    font-size: 12px;\n    font-weight: 700;\n  }\n  .nav-link:hover, .nav-link.active { background: var(--navy-soft); color: #fff; }\n  .nav-link svg { width: 17px; height: 17px; stroke-width: 1.8; color: #7d8f9b; }\n  .nav-link.active svg { color: var(--cyan); }\n  .nav-label { flex: 1; }\n  .pending-count { display: grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 10px; background: var(--cyan); color: var(--navy); font-size: 9px; }\n  .sidebar-footer { margin-top: auto; padding: 16px 11px 0; border-top: 1px solid #2b3944; color: #8797a2; font-size: 9px; line-height: 1.45; }\n  .status-dot { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--green); }\n  .main { min-height: 100vh; margin-left: 232px; }\n  .topbar { height: 88px; display: flex; align-items: center; justify-content: space-between; padding: 0 5.2%; border-bottom: 1px solid var(--line); background: var(--surface); }\n  .mobile-brand { display: none; }\n  .breadcrumb { margin: 0 0 7px; color: var(--muted-soft); font-size: 9px; font-weight: 700; letter-spacing: 1.35px; text-transform: uppercase; }\n  .topbar h1 { margin: 0; font: 700 21px/1.1 'Manrope'; letter-spacing: -.7px; }\n  .topbar-meta { display: flex; align-items: center; gap: 18px; }\n  .today-label { color: var(--muted); font-size: 11px; font-weight: 600; white-space: nowrap; }\n  .today-label strong { color: var(--ink); font-weight: 700; }\n  .local-save { display: inline-flex; align-items: center; gap: 7px; color: #4c9972; font-size: 10px; font-weight: 700; white-space: nowrap; }\n  .local-save svg { width: 15px; height: 15px; stroke-width: 1.8; }\n  .page { max-width: 1180px; margin: 0 auto; padding: 42px 5.2% 64px; }\n  .hero { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 28px; }\n  .eyebrow { margin: 0; color: var(--muted-soft); font-size: 9px; font-weight: 700; letter-spacing: 1.25px; text-transform: uppercase; }\n  .hero h2 { margin: 8px 0 8px; font: 700 30px/1.12 'Manrope'; letter-spacing: -1.15px; }\n  .hero-copy { max-width: 560px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }\n  .primary-button, .outline-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    min-height: 44px;\n    padding: 0 16px;\n    border-radius: 6px;\n    font-size: 11px;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n  .primary-button { border: 1px solid var(--navy); background: var(--navy); color: #fff; }\n  .primary-button:hover { background: #273845; }\n  .outline-button { border: 1px solid #b9dfe0; background: #f3fbfb; color: var(--cyan-ink); }\n  .primary-button svg, .outline-button svg { width: 16px; height: 16px; stroke-width: 2; }\n  .priority-grid { display: grid; grid-template-columns: minmax(0, 1.04fr) minmax(0, 1.45fr); gap: 16px; margin-bottom: 16px; }\n  .today-card, .activity-card, .history-card { border: 1px solid var(--line); border-radius: 9px; box-shadow: var(--shadow); }\n  .today-card { min-height: 254px; display: flex; flex-direction: column; justify-content: space-between; padding: 24px; background: var(--navy); color: #fff; border-color: var(--navy); }\n  .card-top { display: flex; align-items: start; justify-content: space-between; gap: 15px; }\n  .card-top .eyebrow { color: #9aabb6; }\n  .today-status { display: inline-flex; align-items: center; gap: 6px; color: #a9c0ca; font-size: 10px; font-weight: 600; }\n  .today-status i { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); }\n  .today-card h3 { margin: 33px 0 5px; font: 800 43px/1 'Manrope'; letter-spacing: -2px; }\n  .today-helper { margin: 0; color: #a5b5bf; font-size: 11px; }\n  .today-bottom { display: flex; align-items: end; justify-content: space-between; gap: 16px; padding-top: 22px; border-top: 1px solid #2c3b47; }\n  .today-bottom span { color: #9db0ba; font-size: 10px; }\n  .today-bottom strong { display: block; margin-top: 4px; color: #fff; font: 700 15px 'Manrope'; }\n  .today-card .primary-button { border-color: var(--cyan); background: var(--cyan); color: var(--navy); }\n  .today-card .primary-button:hover { background: #b4eff0; }\n  .activity-card { min-height: 254px; padding: 23px 25px; background: var(--surface); }\n  .activity-head { display: flex; align-items: start; justify-content: space-between; gap: 15px; padding-bottom: 17px; border-bottom: 1px solid var(--line); }\n  .activity-head h3, .history-head h3 { margin: 7px 0 0; font: 700 17px/1.15 'Manrope'; letter-spacing: -.35px; }\n  .period-label { color: var(--muted); font-size: 10px; font-weight: 600; }\n  .empty-activity { display: flex; align-items: center; gap: 17px; min-height: 154px; }\n  .empty-icon { display: grid; flex: 0 0 auto; place-items: center; width: 46px; height: 46px; border-radius: 10px; background: #eef8f8; color: var(--cyan-ink); }\n  .empty-icon svg { width: 23px; height: 23px; stroke-width: 1.7; }\n  .empty-activity h4 { margin: 0 0 5px; font: 700 14px/1.2 'Manrope'; }\n  .empty-activity p { max-width: 330px; margin: 0 0 14px; color: var(--muted); font-size: 11px; line-height: 1.45; }\n  .empty-activity .outline-button { min-height: 38px; padding: 0 13px; font-size: 10px; }\n  .stat-strip { display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 16px; padding: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); box-shadow: var(--shadow); }\n  .stat-item { min-height: 82px; display: flex; flex-direction: column; justify-content: center; padding: 0 22px; border-right: 1px solid var(--line); }\n  .stat-item:last-child { border-right: 0; }\n  .stat-label { color: var(--muted); font-size: 10px; font-weight: 600; }\n  .stat-value { margin-top: 7px; color: var(--ink); font: 700 20px/1 'Manrope'; letter-spacing: -.5px; }\n  .stat-note { margin-top: 5px; color: var(--muted-soft); font-size: 9px; }\n  .stat-item:last-child .stat-value { color: var(--muted); font-size: 15px; }\n  .history-card { padding: 21px 24px; background: var(--surface); }\n  .history-head { display: flex; align-items: start; justify-content: space-between; gap: 15px; }\n  .history-link { display: inline-flex; align-items: center; gap: 5px; color: var(--cyan-ink); font-size: 10px; font-weight: 700; }\n  .history-link svg { width: 14px; height: 14px; }\n  .empty-history { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 17px; padding: 14px 16px; border: 1px dashed #cbd8d8; border-radius: 7px; background: #fbfcfc; }\n  .empty-history-copy { display: flex; align-items: center; gap: 11px; }\n  .empty-history-copy svg { width: 18px; height: 18px; color: var(--muted-soft); stroke-width: 1.7; }\n  .empty-history-copy p { margin: 0; color: var(--muted); font-size: 11px; }\n  .empty-history-copy small { display: block; margin-top: 3px; color: var(--muted-soft); font-size: 9px; }\n  .empty-history .outline-button { min-height: 36px; padding: 0 12px; font-size: 10px; }\n  @media (max-width: 1000px) {\n    .sidebar { width: 205px; }\n    .main { margin-left: 205px; }\n    .priority-grid { grid-template-columns: 1fr; }\n    .today-card, .activity-card { min-height: 220px; }\n    .empty-activity { min-height: 120px; }\n  }\n  @media (max-width: 650px) {\n    .sidebar { inset: auto 0 0; width: 100%; height: 74px; padding: 7px 9px 8px; display: block; border-top: 1px solid #273641; }\n    .brand, .sidebar-footer { display: none; }\n    .sidebar nav { height: 100%; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }\n    .nav-link { min-height: 0; height: 100%; padding: 5px 3px; display: flex; flex-direction: column; justify-content: center; gap: 4px; border-radius: 7px; text-align: center; font-size: 9px; }\n    .nav-link svg { width: 18px; height: 18px; }\n    .nav-label { flex: 0 0 auto; }\n    .pending-count { position: absolute; margin: -23px 0 0 19px; min-width: 16px; height: 16px; font-size: 8px; }\n    .main { margin-left: 0; padding-bottom: 74px; }\n    .topbar { height: auto; min-height: 74px; padding: 15px 18px; align-items: center; }\n    .mobile-brand { display: flex; align-items: center; gap: 8px; }\n    .mobile-brand .brand-mark { width: 28px; height: 28px; border-radius: 7px; font-size: 15px; }\n    .mobile-brand span:last-child { font: 800 14px/1 'Manrope'; letter-spacing: -.4px; }\n    .topbar-left .breadcrumb { display: none; }\n    .topbar-left h1 { margin-top: 0; font-size: 16px; }\n    .topbar-meta { gap: 9px; }\n    .today-label { display: none; }\n    .local-save { font-size: 9px; }\n    .local-save span { display: none; }\n    .page { padding: 28px 18px 42px; }\n    .hero { display: block; margin-bottom: 22px; }\n    .hero h2 { font-size: 26px; letter-spacing: -.9px; }\n    .hero-copy { font-size: 11px; }\n    .hero .primary-button { width: 100%; margin-top: 17px; }\n    .priority-grid { gap: 11px; margin-bottom: 11px; }\n    .today-card, .activity-card { min-height: 0; padding: 19px; }\n    .today-card h3 { margin-top: 25px; font-size: 37px; }\n    .today-bottom { align-items: stretch; flex-direction: column; gap: 15px; padding-top: 17px; }\n    .today-card .primary-button { width: 100%; }\n    .activity-card { padding: 19px; }\n    .activity-head { padding-bottom: 14px; }\n    .empty-activity { align-items: flex-start; padding: 17px 0 2px; }\n    .empty-icon { width: 40px; height: 40px; border-radius: 9px; }\n    .empty-icon svg { width: 20px; height: 20px; }\n    .empty-activity h4 { font-size: 13px; }\n    .empty-activity p { font-size: 10px; }\n    .stat-strip { grid-template-columns: repeat(2, 1fr); }\n    .stat-item { min-height: 74px; padding: 0 15px; }\n    .stat-item:nth-child(2) { border-right: 0; }\n    .stat-item:nth-child(-n+2) { border-bottom: 1px solid var(--line); }\n    .stat-value { font-size: 18px; }\n    .history-card { padding: 18px; }\n    .empty-history { align-items: flex-start; flex-direction: column; }\n    .empty-history .outline-button { width: 100%; }\n  }\n</style>\n<div class=\"app-shell\" data-kid=\"1\">\n    <aside aria-label=\"Navegación principal\" class=\"sidebar\" data-kid=\"1-1\">\n        <a aria-label=\"Pichangas, resumen\" class=\"brand\" data-kid=\"1-1-1\" href=\"#resumen\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                P\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                <span class=\"brand-name\" data-kid=\"1-1-1-2-1\">\n                    PICHANGAS\n                </span>\n                <span class=\"brand-subtitle\" data-kid=\"1-1-1-2-2\">\n                    CONTROL DE VENTAS\n                </span>\n            </span>\n        </a>\n        <nav data-kid=\"1-1-2\">\n            <button aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-2-1\" type=\"button\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-2-1-1\" data-lucide=\"layout-dashboard\">\n                </i>\n                <span class=\"nav-label\" data-kid=\"1-1-2-1-2\">\n                    Resumen\n                </span>\n            </button>\n            <button class=\"nav-link\" data-kid=\"1-1-2-2\" type=\"button\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1\" data-lucide=\"plus\">\n                </i>\n                <span class=\"nav-label\" data-kid=\"1-1-2-2-2\">\n                    Cierre\n                </span>\n            </button>\n            <button class=\"nav-link\" data-kid=\"1-1-2-3\" type=\"button\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-2-3-1\" data-lucide=\"bike\">\n                </i>\n                <span class=\"nav-label\" data-kid=\"1-1-2-3-2\">\n                    Repartos\n                </span>\n                <b class=\"pending-count\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3\" data-name=\"pending items count badge\" data-reason=\"value updated dynamically by store state\">\n                    0\n                </b>\n            </button>\n            <button class=\"nav-link\" data-kid=\"1-1-2-4\" type=\"button\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-2-4-1\" data-lucide=\"chart-no-axes-column-increasing\">\n                </i>\n                <span class=\"nav-label\" data-kid=\"1-1-2-4-2\">\n                    Reportes\n                </span>\n            </button>\n        </nav>\n        <div class=\"sidebar-footer\" data-kid=\"1-1-3\">\n            <span class=\"status-dot\" data-kid=\"1-1-3-1\">\n            </span>\n            Guardado en este dispositivo\n        </div>\n    </aside>\n    <main class=\"main\" data-kid=\"1-2\">\n        <header class=\"topbar\" data-kid=\"1-2-1\">\n            <div class=\"topbar-left\" data-kid=\"1-2-1-1\">\n                <div class=\"mobile-brand\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"brand-mark\" data-kid=\"1-2-1-1-1-1\">\n                        P\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-2\">\n                        PICHANGAS\n                    </span>\n                </div>\n                <p class=\"breadcrumb\" data-kid=\"1-2-1-1-2\">\n                    PICHANGAS / CONTROL\n                </p>\n                <h1 data-kid=\"1-2-1-1-3\">\n                    Resumen del negocio\n                </h1>\n            </div>\n            <div class=\"topbar-meta\" data-kid=\"1-2-1-2\">\n                <span class=\"today-label\" data-kid=\"1-2-1-2-1\">\n                    <strong data-dynamic=\"true\" data-kid=\"1-2-1-2-1-1\" data-name=\"current date display text\" data-reason=\"text set dynamically based on system time\">\n                        Lunes 7 de septiembre\n                    </strong>\n                    · 2026\n                </span>\n                <span class=\"local-save\" data-kid=\"1-2-1-2-2\">\n                    <i aria-hidden=\"true\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"hard-drive\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        Guardado en este dispositivo\n                    </span>\n                </span>\n            </div>\n        </header>\n        <div class=\"page\" data-kid=\"1-2-2\">\n            <section aria-labelledby=\"welcome-title\" class=\"hero\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <p class=\"eyebrow\" data-kid=\"1-2-2-1-1-1\">\n                        Panel del dueño\n                    </p>\n                    <h2 data-kid=\"1-2-2-1-1-2\" id=\"welcome-title\">\n                        Hola, aquí está tu negocio.\n                    </h2>\n                    <p class=\"hero-copy\" data-kid=\"1-2-2-1-1-3\">\n                        Registra el cierre de hoy para empezar a ver tus ventas y mantener el turno bajo control.\n                    </p>\n                </div>\n                <button class=\"primary-button\" data-kid=\"1-2-2-1-2\" type=\"button\">\n                    <i aria-hidden=\"true\" data-kid=\"1-2-2-1-2-1\" data-lucide=\"plus\">\n                    </i>\n                    Registrar cierre\n                </button>\n            </section>\n            <section aria-label=\"Estado de ventas y actividad\" class=\"priority-grid\" data-kid=\"1-2-2-2\">\n                <article class=\"today-card\" data-kid=\"1-2-2-2-1\">\n                    <div data-kid=\"1-2-2-2-1-1\">\n                        <div class=\"card-top\" data-kid=\"1-2-2-2-1-1-1\">\n                            <p class=\"eyebrow\" data-kid=\"1-2-2-2-1-1-1-1\">\n                                Ventas de hoy\n                            </p>\n                            <span class=\"today-status\" data-kid=\"1-2-2-2-1-1-1-2\">\n                                <i data-kid=\"1-2-2-2-1-1-1-2-1\">\n                                </i>\n                                Turno sin cerrar\n                            </span>\n                        </div>\n                        <h3 data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"today's total sales amount\" data-reason=\"amount updated dynamically after closure registration\">\n                            $0\n                        </h3>\n                        <p class=\"today-helper\" data-kid=\"1-2-2-2-1-1-3\">\n                            Aún no has registrado el cierre de hoy.\n                        </p>\n                    </div>\n                    <div class=\"today-bottom\" data-kid=\"1-2-2-2-1-2\">\n                        <div data-kid=\"1-2-2-2-1-2-1\">\n                            <span data-kid=\"1-2-2-2-1-2-1-1\">\n                                Productos vendidos\n                            </span>\n                            <strong data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"today's total units sold\" data-reason=\"value updated dynamically after closure registration\">\n                                0 unidades\n                            </strong>\n                        </div>\n                        <button class=\"primary-button\" data-kid=\"1-2-2-2-1-2-2\" type=\"button\">\n                            <i aria-hidden=\"true\" data-kid=\"1-2-2-2-1-2-2-1\" data-lucide=\"clipboard-pen-line\">\n                            </i>\n                            Registrar cierre\n                        </button>\n                    </div>\n                </article>\n                <article class=\"activity-card\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"activity-head\" data-kid=\"1-2-2-2-2-1\">\n                        <div data-kid=\"1-2-2-2-2-1-1\">\n                            <p class=\"eyebrow\" data-kid=\"1-2-2-2-2-1-1-1\">\n                                Actividad\n                            </p>\n                            <h3 data-kid=\"1-2-2-2-2-1-1-2\">\n                                Ventas de los últimos 7 días\n                            </h3>\n                        </div>\n                        <span class=\"period-label\" data-kid=\"1-2-2-2-2-1-2\">\n                            Semana actual\n                        </span>\n                    </div>\n                    <div class=\"empty-activity\" data-kid=\"1-2-2-2-2-2\">\n                        <span class=\"empty-icon\" data-kid=\"1-2-2-2-2-2-1\">\n                            <i aria-hidden=\"true\" data-kid=\"1-2-2-2-2-2-1-1\" data-lucide=\"chart-no-axes-column\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-2-2-2-2-2\">\n                            <h4 data-kid=\"1-2-2-2-2-2-2-1\">\n                                Aún no hay ventas registradas\n                            </h4>\n                            <p data-kid=\"1-2-2-2-2-2-2-2\">\n                                Registra tu primer cierre para empezar a ver el ritmo de la semana.\n                            </p>\n                            <button class=\"outline-button\" data-kid=\"1-2-2-2-2-2-2-3\" type=\"button\">\n                                <i aria-hidden=\"true\" data-kid=\"1-2-2-2-2-2-2-3-1\" data-lucide=\"arrow-right\">\n                                </i>\n                                Registrar primer cierre\n                            </button>\n                        </div>\n                    </div>\n                </article>\n            </section>\n            <section aria-label=\"Resumen de periodos\" class=\"stat-strip\" data-kid=\"1-2-2-3\">\n                <div class=\"stat-item\" data-kid=\"1-2-2-3-1\">\n                    <span class=\"stat-label\" data-kid=\"1-2-2-3-1-1\">\n                        Esta semana\n                    </span>\n                    <strong class=\"stat-value\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-2\" data-name=\"weekly total sales amount\" data-reason=\"amount updated dynamically by data records\">\n                        $0\n                    </strong>\n                    <span class=\"stat-note\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-3\" data-name=\"weekly days registered count\" data-reason=\"count updated dynamically by data records\">\n                        0 días registrados\n                    </span>\n                </div>\n                <div class=\"stat-item\" data-kid=\"1-2-2-3-2\">\n                    <span class=\"stat-label\" data-kid=\"1-2-2-3-2-1\">\n                        Este mes\n                    </span>\n                    <strong class=\"stat-value\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2\" data-name=\"monthly total sales amount\" data-reason=\"amount updated dynamically by data records\">\n                        $0\n                    </strong>\n                    <span class=\"stat-note\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3\" data-name=\"monthly days registered count\" data-reason=\"count updated dynamically by data records\">\n                        0 días registrados\n                    </span>\n                </div>\n                <div class=\"stat-item\" data-kid=\"1-2-2-3-3\">\n                    <span class=\"stat-label\" data-kid=\"1-2-2-3-3-1\">\n                        Promedio diario\n                    </span>\n                    <strong class=\"stat-value\" data-dynamic=\"true\" data-kid=\"1-2-2-3-3-2\" data-name=\"daily average sales amount\" data-reason=\"amount computed and updated dynamically by data records\">\n                        $0\n                    </strong>\n                    <span class=\"stat-note\" data-kid=\"1-2-2-3-3-3\">\n                        sobre días registrados\n                    </span>\n                </div>\n                <div class=\"stat-item\" data-kid=\"1-2-2-3-4\">\n                    <span class=\"stat-label\" data-kid=\"1-2-2-3-4-1\">\n                        Mejor día\n                    </span>\n                    <strong class=\"stat-value\" data-dynamic=\"true\" data-kid=\"1-2-2-3-4-2\" data-name=\"best performing day label\" data-reason=\"label updated dynamically based on data records\">\n                        Sin datos\n                    </strong>\n                    <span class=\"stat-note\" data-kid=\"1-2-2-3-4-3\">\n                        cuando registres ventas\n                    </span>\n                </div>\n            </section>\n            <section aria-labelledby=\"history-title\" class=\"history-card\" data-kid=\"1-2-2-4\">\n                <div class=\"history-head\" data-kid=\"1-2-2-4-1\">\n                    <div data-kid=\"1-2-2-4-1-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-2-2-4-1-1-1\">\n                            Historial\n                        </p>\n                        <h3 data-kid=\"1-2-2-4-1-1-2\" id=\"history-title\">\n                            Últimos cierres\n                        </h3>\n                    </div>\n                    <span class=\"history-link\" data-kid=\"1-2-2-4-1-2\">\n                        Ver reportes\n                        <i aria-hidden=\"true\" data-kid=\"1-2-2-4-1-2-1\" data-lucide=\"arrow-up-right\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"empty-history\" data-kid=\"1-2-2-4-2\">\n                    <div class=\"empty-history-copy\" data-kid=\"1-2-2-4-2-1\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-2-4-2-1-1\" data-lucide=\"inbox\">\n                        </i>\n                        <div data-kid=\"1-2-2-4-2-1-2\">\n                            <p data-kid=\"1-2-2-4-2-1-2-1\">\n                                Todavía no hay cierres guardados.\n                            </p>\n                            <small data-kid=\"1-2-2-4-2-1-2-2\">\n                                Tu historial aparecerá después del primer cierre.\n                            </small>\n                        </div>\n                    </div>\n                    <button class=\"outline-button\" data-kid=\"1-2-2-4-2-2\" type=\"button\">\n                        Registrar primer cierre\n                    </button>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/lucide@0.468.0/dist/umd/lucide.min.js\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
      "comments": [],
      "created": "2026-09-07T07:15:11.213153+00:00",
      "modified": "2026-09-07T07:15:52.874950+00:00",
      "id": "var_6b0e8a898c1d"
    },
    "var_cb8373152da8": {
      "type": "variant",
      "label": "Pichangas — Comanda Clara",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n  :root {\n    --navy: #111820;\n    --navy-2: #1b2934;\n    --paper: #f4f6f5;\n    --surface: #ffffff;\n    --ink: #202b34;\n    --muted: #667780;\n    --soft-muted: #82919a;\n    --line: #dce4e4;\n    --cyan: #8bdee0;\n    --cyan-deep: #287e80;\n    --green: #57b980;\n    --green-soft: #e9f6ef;\n  }\n  body {\n    margin: 0;\n    min-width: 320px;\n    min-height: 100vh;\n    overflow-x: hidden;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: 'DM Sans', sans-serif;\n    font-synthesis: none;\n  }\n  button, a { font: inherit; }\n  button { border: 0; cursor: pointer; }\n  .dashboard-shell { min-height: 100vh; }\n  .desktop-sidebar {\n    position: fixed;\n    inset: 0 auto 0 0;\n    z-index: 20;\n    display: flex;\n    width: 232px;\n    flex-direction: column;\n    padding: 30px 18px 22px;\n    background: var(--navy);\n    color: #fff;\n  }\n  .brand {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin: 0 10px 62px;\n    color: #fff;\n    text-decoration: none;\n  }\n  .brand-mark {\n    display: grid;\n    width: 32px;\n    height: 32px;\n    place-items: center;\n    border-radius: 8px;\n    background: var(--cyan);\n    color: var(--navy);\n    font: 800 17px/1 'Manrope', sans-serif;\n  }\n  .brand-name { font: 800 17px/1 'Manrope', sans-serif; letter-spacing: -.55px; }\n  .brand-subtitle {\n    display: block;\n    margin-top: 5px;\n    color: #96a4ae;\n    font-size: 7px;\n    font-weight: 700;\n    letter-spacing: 1.15px;\n  }\n  .sidebar-nav { display: grid; gap: 7px; }\n  .sidebar-link {\n    display: flex;\n    min-height: 44px;\n    align-items: center;\n    gap: 12px;\n    padding: 0 13px;\n    border-radius: 7px;\n    background: transparent;\n    color: #94a3ad;\n    font-size: 12px;\n    font-weight: 700;\n    text-align: left;\n  }\n  .sidebar-link .icon { width: 17px; height: 17px; color: #82929d; stroke-width: 1.8; }\n  .sidebar-link.active { background: #233440; color: #fff; }\n  .sidebar-link.active .icon { color: var(--cyan); }\n  .sidebar-footer {\n    display: flex;\n    align-items: center;\n    margin-top: auto;\n    padding: 15px 11px 0;\n    border-top: 1px solid #2b3944;\n    color: #8d9ca6;\n    font-size: 10px;\n    line-height: 1.45;\n  }\n  .status-dot { width: 7px; height: 7px; flex: 0 0 auto; margin-right: 7px; border-radius: 50%; background: var(--green); }\n  .app-main { min-width: 0; min-height: 100vh; margin-left: 232px; }\n  .topbar {\n    display: flex;\n    min-height: 88px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 0 5%;\n    border-bottom: 1px solid var(--line);\n    background: var(--surface);\n  }\n  .breadcrumb, .eyebrow {\n    margin: 0;\n    color: #7c8c95;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n  }\n  .topbar h1 {\n    margin: 7px 0 0;\n    color: var(--ink);\n    font: 700 22px/1.05 'Manrope', sans-serif;\n    letter-spacing: -.65px;\n  }\n  .date-chip {\n    display: flex;\n    min-height: 42px;\n    align-items: center;\n    gap: 9px;\n    padding: 0 13px;\n    border: 1px solid var(--line);\n    border-radius: 7px;\n    background: #fbfcfc;\n    color: var(--muted);\n    font-size: 11px;\n    font-weight: 600;\n    white-space: nowrap;\n  }\n  .date-chip .icon { width: 16px; height: 16px; color: var(--cyan-deep); stroke-width: 1.8; }\n  .page-content { max-width: 1180px; margin: 0 auto; padding: 42px 5% 70px; }\n  .page-intro { margin-bottom: 25px; }\n  .page-intro h2 {\n    margin: 9px 0 7px;\n    color: var(--ink);\n    font: 700 30px/1.08 'Manrope', sans-serif;\n    letter-spacing: -1.15px;\n  }\n  .muted { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.45; }\n  .hero-command {\n    position: relative;\n    overflow: hidden;\n    padding: 24px 26px 22px;\n    border-radius: 8px;\n    background: var(--navy);\n    color: #fff;\n  }\n  .hero-command::after {\n    position: absolute;\n    right: 28px;\n    bottom: -42px;\n    width: 150px;\n    height: 150px;\n    border: 1px solid rgba(139, 222, 224, .2);\n    border-radius: 50%;\n    content: '';\n  }\n  .hero-top, .hero-bottom { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; }\n  .hero-top { align-items: flex-start; }\n  .ticket-label {\n    display: inline-flex;\n    min-height: 30px;\n    align-items: center;\n    gap: 8px;\n    padding: 0 10px;\n    border: 1px solid rgba(139, 222, 224, .35);\n    border-radius: 6px;\n    background: rgba(139, 222, 224, .1);\n    color: var(--cyan);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .55px;\n    text-transform: uppercase;\n  }\n  .ticket-label .icon { width: 14px; height: 14px; stroke-width: 1.8; }\n  .hero-status { display: block; margin-top: 10px; color: #9baab3; font-size: 12px; }\n  .hero-total { color: #fff; font: 800 38px/1 'Manrope', sans-serif; letter-spacing: -1.4px; }\n  .hero-bottom { align-items: flex-end; margin-top: 26px; }\n  .hero-title { margin: 0 0 5px; font: 700 16px/1.2 'Manrope', sans-serif; }\n  .hero-helper { margin: 0; color: #a9b6bd; font-size: 13px; line-height: 1.4; }\n  .primary-cta {\n    display: inline-flex;\n    min-height: 46px;\n    align-items: center;\n    gap: 10px;\n    padding: 0 16px;\n    border-radius: 6px;\n    background: var(--cyan);\n    color: var(--navy);\n    font-size: 12px;\n    font-weight: 800;\n    white-space: nowrap;\n  }\n  .primary-cta .icon { width: 16px; height: 16px; stroke-width: 2.2; }\n  .metrics-band {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    margin: 24px 0 30px;\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n    background: var(--surface);\n  }\n  .metric-cell { min-width: 0; padding: 18px 22px 17px; }\n  .metric-cell + .metric-cell { border-left: 1px solid var(--line); }\n  .metric-label { margin: 0 0 8px; color: var(--muted); font-size: 13px; font-weight: 600; }\n  .metric-value { display: block; color: var(--ink); font: 700 22px/1 'Manrope', sans-serif; letter-spacing: -.65px; }\n  .metric-note { display: block; margin-top: 7px; color: var(--soft-muted); font-size: 12px; }\n  .flat-section { border-top: 1px solid var(--line); }\n  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 20px 0 15px; }\n  .section-title { margin: 7px 0 0; color: var(--ink); font: 700 18px/1.15 'Manrope', sans-serif; letter-spacing: -.35px; }\n  .section-meta { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; }\n  .section-meta .icon { width: 15px; height: 15px; color: var(--cyan-deep); stroke-width: 1.8; }\n  .empty-activity {\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr) auto;\n    align-items: center;\n    gap: 15px;\n    padding: 17px 0 20px;\n    border-bottom: 1px solid var(--line);\n  }\n  .empty-mark {\n    display: grid;\n    width: 42px;\n    height: 42px;\n    place-items: center;\n    border-radius: 7px;\n    background: #e7f6f5;\n    color: var(--cyan-deep);\n  }\n  .empty-mark .icon { width: 20px; height: 20px; stroke-width: 1.7; }\n  .empty-activity h4 { margin: 0 0 5px; font: 700 14px/1.25 'Manrope', sans-serif; }\n  .empty-activity p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.4; }\n  .inline-action { display: inline-flex; align-items: center; gap: 5px; color: var(--cyan-deep); font-size: 12px; font-weight: 800; white-space: nowrap; }\n  .inline-action .icon { width: 15px; height: 15px; stroke-width: 2; }\n  .delivery-section { padding-top: 26px; }\n  .delivery-row {\n    display: flex;\n    min-height: 58px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 13px 0;\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n  }\n  .delivery-label { display: flex; align-items: center; gap: 10px; }\n  .delivery-label .icon { width: 18px; height: 18px; color: var(--cyan-deep); stroke-width: 1.7; }\n  .delivery-label strong { display: block; font: 700 14px/1.2 'Manrope', sans-serif; }\n  .delivery-label small { display: block; margin-top: 3px; color: var(--muted); font-size: 12px; }\n  .delivery-status { display: inline-flex; align-items: center; gap: 8px; color: #3f9368; font-size: 13px; font-weight: 700; }\n  .delivery-status .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }\n  .mobile-bottom-nav { display: none; }\n  @media (max-width: 700px) {\n    .desktop-sidebar { display: none; }\n    .app-main { margin-left: 0; padding-bottom: 88px; }\n    .topbar { min-height: 76px; padding: 17px 18px; }\n    .topbar h1 { font-size: 18px; }\n    .breadcrumb { font-size: 9px; letter-spacing: .95px; }\n    .date-chip { min-height: 38px; padding: 0 10px; font-size: 0; }\n    .date-chip .icon { width: 17px; height: 17px; }\n    .page-content { padding: 28px 18px 35px; }\n    .page-intro { margin-bottom: 21px; }\n    .page-intro h2 { font-size: 25px; letter-spacing: -.9px; }\n    .muted { font-size: 13px; }\n    .hero-command { padding: 20px 18px 18px; }\n    .hero-command::after { right: -44px; bottom: -67px; width: 145px; height: 145px; }\n    .hero-top { gap: 10px; }\n    .hero-total { font-size: 32px; }\n    .hero-bottom { display: block; margin-top: 24px; }\n    .hero-helper { max-width: 245px; font-size: 13px; }\n    .primary-cta { width: 100%; justify-content: center; margin-top: 17px; }\n    .metrics-band { grid-template-columns: 1fr; margin: 18px 0 26px; }\n    .metric-cell { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 12px; padding: 14px 15px; }\n    .metric-cell + .metric-cell { border-top: 1px solid var(--line); border-left: 0; }\n    .metric-label { grid-column: 1; margin: 0; font-size: 13px; }\n    .metric-value { grid-column: 2; grid-row: 1 / span 2; font-size: 21px; }\n    .metric-note { grid-column: 1; margin: 0; font-size: 12px; }\n    .section-head { align-items: flex-start; padding-top: 18px; }\n    .section-title { font-size: 17px; }\n    .section-meta { font-size: 11px; }\n    .empty-activity { grid-template-columns: auto minmax(0, 1fr); gap: 12px; padding: 15px 0 18px; }\n    .empty-mark { width: 38px; height: 38px; }\n    .empty-mark .icon { width: 18px; height: 18px; }\n    .empty-activity h4 { font-size: 13px; }\n    .empty-activity p { font-size: 12px; }\n    .empty-activity .inline-action { grid-column: 2; justify-self: start; margin-top: 2px; }\n    .delivery-section { padding-top: 22px; }\n    .delivery-row { min-height: 54px; }\n    .delivery-label strong { font-size: 13px; }\n    .delivery-label small { font-size: 12px; }\n    .delivery-status { font-size: 12px; }\n    .mobile-bottom-nav {\n      position: fixed;\n      right: 0;\n      bottom: 0;\n      left: 0;\n      z-index: 30;\n      display: grid;\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n      gap: 3px;\n      padding: 8px 10px calc(8px + env(safe-area-inset-bottom));\n      border-top: 1px solid var(--line);\n      background: rgba(255,255,255,.97);\n      box-shadow: 0 -8px 24px rgba(29,48,61,.07);\n    }\n    .mobile-nav-item {\n      display: flex;\n      min-width: 0;\n      min-height: 44px;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 4px;\n      border-radius: 6px;\n      background: transparent;\n      color: var(--soft-muted);\n      font-size: 10px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n    .mobile-nav-item .icon { width: 18px; height: 18px; stroke-width: 1.8; }\n    .mobile-nav-item.active { background: #e7f6f5; color: var(--cyan-deep); }\n  }\n</style>\n<div class=\"dashboard-shell\" data-kid=\"1\">\n    <aside aria-label=\"Navegación principal\" class=\"desktop-sidebar\" data-kid=\"1-1\">\n        <a class=\"brand\" data-kid=\"1-1-1\" href=\"#resumen\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                P\n            </span>\n            <span class=\"brand-name\" data-kid=\"1-1-1-2\">\n                PICHANGAS\n                <span class=\"brand-subtitle\" data-kid=\"1-1-1-2-1\">\n                    CONTROL DE VENTAS\n                </span>\n            </span>\n        </a>\n        <nav aria-label=\"Secciones\" class=\"sidebar-nav\" data-kid=\"1-1-2\">\n            <button class=\"sidebar-link active\" data-kid=\"1-1-2-1\" type=\"button\">\n                <i class=\"icon\" data-kid=\"1-1-2-1-1\" data-lucide=\"layout-dashboard\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\">\n                    Resumen\n                </span>\n            </button>\n            <button class=\"sidebar-link\" data-kid=\"1-1-2-2\" type=\"button\">\n                <i class=\"icon\" data-kid=\"1-1-2-2-1\" data-lucide=\"plus\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\">\n                    Cierre diario\n                </span>\n            </button>\n            <button class=\"sidebar-link\" data-kid=\"1-1-2-3\" type=\"button\">\n                <i class=\"icon\" data-kid=\"1-1-2-3-1\" data-lucide=\"bike\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\">\n                    Repartos\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-1-2-3-3\" data-name=\"repartos pending count badge\" data-reason=\"number text fetched and updated by script\" style=\"margin-left:auto;display:grid;min-width:20px;height:20px;place-items:center;border-radius:999px;background:var(--cyan);color:var(--navy);font-size:10px;font-weight:800;\">\n                    0\n                </span>\n            </button>\n            <button class=\"sidebar-link\" data-kid=\"1-1-2-4\" type=\"button\">\n                <i class=\"icon\" data-kid=\"1-1-2-4-1\" data-lucide=\"bar-chart-3\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\">\n                    Reportes\n                </span>\n            </button>\n        </nav>\n        <div class=\"sidebar-footer\" data-kid=\"1-1-3\">\n            <span class=\"status-dot\" data-kid=\"1-1-3-1\">\n            </span>\n            <span data-kid=\"1-1-3-2\">\n                Datos guardados en este dispositivo\n            </span>\n        </div>\n    </aside>\n    <main class=\"app-main\" data-kid=\"1-2\">\n        <header class=\"topbar\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <p class=\"breadcrumb\" data-kid=\"1-2-1-1-1\">\n                    PICHANGAS / CONTROL\n                </p>\n                <h1 data-kid=\"1-2-1-1-2\">\n                    Resumen del negocio\n                </h1>\n            </div>\n            <div class=\"date-chip\" data-kid=\"1-2-1-2\">\n                <i class=\"icon\" data-kid=\"1-2-1-2-1\" data-lucide=\"calendar-days\">\n                </i>\n                <span data-dynamic=\"true\" data-kid=\"1-2-1-2-2\" data-name=\"date display text\" data-reason=\"date text rendered based on current system date by script\">\n                    Hoy · 07 sep 2026\n                </span>\n            </div>\n        </header>\n        <div class=\"page-content\" data-kid=\"1-2-2\">\n            <div class=\"page-intro\" data-kid=\"1-2-2-1\">\n                <p class=\"eyebrow\" data-kid=\"1-2-2-1-1\">\n                    Panel del dueño\n                </p>\n                <h2 data-kid=\"1-2-2-1-2\">\n                    Hola, aquí está tu negocio.\n                </h2>\n                <p class=\"muted\" data-kid=\"1-2-2-1-3\">\n                    Registra el cierre del día y revisa cómo avanza tu operación.\n                </p>\n            </div>\n            <section aria-label=\"Cierre de hoy\" class=\"hero-command\" data-kid=\"1-2-2-2\">\n                <div class=\"hero-top\" data-kid=\"1-2-2-2-1\">\n                    <div data-kid=\"1-2-2-2-1-1\">\n                        <span class=\"ticket-label\" data-kid=\"1-2-2-2-1-1-1\">\n                            <i class=\"icon\" data-kid=\"1-2-2-2-1-1-1-1\" data-lucide=\"receipt-text\">\n                            </i>\n                            Cierre de hoy\n                        </span>\n                        <span class=\"hero-status\" data-kid=\"1-2-2-2-1-1-2\">\n                            Aún no registrado\n                        </span>\n                    </div>\n                    <strong class=\"hero-total\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2\" data-name=\"hero total sales amount\" data-reason=\"amount value calculated and updated from dashboard state\">\n                        $0\n                    </strong>\n                </div>\n                <div class=\"hero-bottom\" data-kid=\"1-2-2-2-2\">\n                    <div data-kid=\"1-2-2-2-2-1\">\n                        <p class=\"hero-title\" data-kid=\"1-2-2-2-2-1-1\">\n                            Ventas del día\n                        </p>\n                        <p class=\"hero-helper\" data-kid=\"1-2-2-2-2-1-2\">\n                            Ingresa tus productos, bebidas y repartos para cerrar la jornada.\n                        </p>\n                    </div>\n                    <button class=\"primary-cta\" data-kid=\"1-2-2-2-2-2\" type=\"button\">\n                        Registrar cierre\n                        <i class=\"icon\" data-kid=\"1-2-2-2-2-2-1\" data-lucide=\"arrow-right\">\n                        </i>\n                    </button>\n                </div>\n            </section>\n            <section aria-label=\"Resumen de periodos\" class=\"metrics-band\" data-kid=\"1-2-2-3\">\n                <div class=\"metric-cell\" data-kid=\"1-2-2-3-1\">\n                    <p class=\"metric-label\" data-kid=\"1-2-2-3-1-1\">\n                        Esta semana\n                    </p>\n                    <strong class=\"metric-value\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-2\" data-name=\"weekly sales total amount\" data-reason=\"amount value calculated and updated from dashboard state\">\n                        $0\n                    </strong>\n                    <span class=\"metric-note\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-3\" data-name=\"weekly sales days counter\" data-reason=\"days count updated from dashboard state\">\n                        0 días registrados\n                    </span>\n                </div>\n                <div class=\"metric-cell\" data-kid=\"1-2-2-3-2\">\n                    <p class=\"metric-label\" data-kid=\"1-2-2-3-2-1\">\n                        Este mes\n                    </p>\n                    <strong class=\"metric-value\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-2\" data-name=\"monthly sales total amount\" data-reason=\"amount value calculated and updated from dashboard state\">\n                        $0\n                    </strong>\n                    <span class=\"metric-note\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3\" data-name=\"monthly sales days counter\" data-reason=\"days count updated from dashboard state\">\n                        0 días registrados\n                    </span>\n                </div>\n                <div class=\"metric-cell\" data-kid=\"1-2-2-3-3\">\n                    <p class=\"metric-label\" data-kid=\"1-2-2-3-3-1\">\n                        Promedio diario\n                    </p>\n                    <strong class=\"metric-value\" data-dynamic=\"true\" data-kid=\"1-2-2-3-3-2\" data-name=\"average daily sales amount\" data-reason=\"amount value calculated and updated from dashboard state\">\n                        $0\n                    </strong>\n                    <span class=\"metric-note\" data-dynamic=\"true\" data-kid=\"1-2-2-3-3-3\" data-name=\"average daily sales note\" data-reason=\"note text updated based on days count state\">\n                        Sobre días registrados\n                    </span>\n                </div>\n            </section>\n            <section aria-label=\"Actividad de la semana\" class=\"flat-section\" data-kid=\"1-2-2-4\">\n                <div class=\"section-head\" data-kid=\"1-2-2-4-1\">\n                    <div data-kid=\"1-2-2-4-1-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-2-2-4-1-1-1\">\n                            Actividad de la semana\n                        </p>\n                        <h3 class=\"section-title\" data-kid=\"1-2-2-4-1-1-2\">\n                            Ventas recientes\n                        </h3>\n                    </div>\n                    <span class=\"section-meta\" data-kid=\"1-2-2-4-1-2\">\n                        <i class=\"icon\" data-kid=\"1-2-2-4-1-2-1\" data-lucide=\"calendar-range\">\n                        </i>\n                        Últimos 7 días\n                    </span>\n                </div>\n                <div class=\"empty-activity\" data-kid=\"1-2-2-4-2\">\n                    <div class=\"empty-mark\" data-kid=\"1-2-2-4-2-1\">\n                        <i class=\"icon\" data-kid=\"1-2-2-4-2-1-1\" data-lucide=\"clipboard-list\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-2-4-2-2\">\n                        <h4 data-kid=\"1-2-2-4-2-2-1\">\n                            Registra un cierre para ver tu semana\n                        </h4>\n                        <p data-kid=\"1-2-2-4-2-2-2\">\n                            Cuando guardes el primer cierre, aquí aparecerá la actividad de los últimos 7 días.\n                        </p>\n                    </div>\n                    <span class=\"inline-action\" data-kid=\"1-2-2-4-2-3\">\n                        Ir a cierre\n                        <i class=\"icon\" data-kid=\"1-2-2-4-2-3-1\" data-lucide=\"arrow-right\">\n                        </i>\n                    </span>\n                </div>\n            </section>\n            <section aria-label=\"Repartos pendientes\" class=\"delivery-section\" data-kid=\"1-2-2-5\">\n                <div class=\"section-head\" data-kid=\"1-2-2-5-1\" style=\"padding-top:0;\">\n                    <div data-kid=\"1-2-2-5-1-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-2-2-5-1-1-1\">\n                            Operación en curso\n                        </p>\n                        <h3 class=\"section-title\" data-kid=\"1-2-2-5-1-1-2\">\n                            Repartos pendientes\n                        </h3>\n                    </div>\n                    <span class=\"section-meta\" data-kid=\"1-2-2-5-1-2\">\n                        <i class=\"icon\" data-kid=\"1-2-2-5-1-2-1\" data-lucide=\"bike\">\n                        </i>\n                        Hoy\n                    </span>\n                </div>\n                <div class=\"delivery-row\" data-kid=\"1-2-2-5-2\">\n                    <div class=\"delivery-label\" data-kid=\"1-2-2-5-2-1\">\n                        <i class=\"icon\" data-kid=\"1-2-2-5-2-1-1\" data-lucide=\"package-check\">\n                        </i>\n                        <div data-kid=\"1-2-2-5-2-1-2\">\n                            <strong data-kid=\"1-2-2-5-2-1-2-1\">\n                                Lista al día\n                            </strong>\n                            <small data-kid=\"1-2-2-5-2-1-2-2\">\n                                No hay entregas esperando cierre.\n                            </small>\n                        </div>\n                    </div>\n                    <span class=\"delivery-status\" data-kid=\"1-2-2-5-2-2\">\n                        <span class=\"dot\" data-kid=\"1-2-2-5-2-2-1\">\n                        </span>\n                        0 pendientes\n                    </span>\n                </div>\n            </section>\n        </div>\n    </main>\n    <nav aria-label=\"Navegación móvil\" class=\"mobile-bottom-nav\" data-kid=\"1-3\">\n        <button class=\"mobile-nav-item active\" data-kid=\"1-3-1\" type=\"button\">\n            <i class=\"icon\" data-kid=\"1-3-1-1\" data-lucide=\"layout-dashboard\">\n            </i>\n            <span data-kid=\"1-3-1-2\">\n                Resumen\n            </span>\n        </button>\n        <button class=\"mobile-nav-item\" data-kid=\"1-3-2\" type=\"button\">\n            <i class=\"icon\" data-kid=\"1-3-2-1\" data-lucide=\"plus\">\n            </i>\n            <span data-kid=\"1-3-2-2\">\n                Cierre\n            </span>\n        </button>\n        <button class=\"mobile-nav-item\" data-kid=\"1-3-3\" type=\"button\">\n            <i class=\"icon\" data-kid=\"1-3-3-1\" data-lucide=\"bike\">\n            </i>\n            <span data-kid=\"1-3-3-2\">\n                Repartos\n            </span>\n        </button>\n        <button class=\"mobile-nav-item\" data-kid=\"1-3-4\" type=\"button\">\n            <i class=\"icon\" data-kid=\"1-3-4-1\" data-lucide=\"bar-chart-3\">\n            </i>\n            <span data-kid=\"1-3-4-2\">\n                Reportes\n            </span>\n        </button>\n    </nav>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
